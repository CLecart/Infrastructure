# Environment of compose.yaml. Copy to .env, which Git ignores, and replace
# every CHANGE_ME, for instance with the output of `openssl rand -hex 24`.
INVENTORY_DB_USER=inventory_user
INVENTORY_DB_PASSWORD=CHANGE_ME
BILLING_DB_USER=billing_user
BILLING_DB_PASSWORD=CHANGE_ME
RABBITMQ_USER=rabbit_user
RABBITMQ_PASSWORD=CHANGE_ME
# Port of the API on the loopback interface of the host.
API_GATEWAY_PORT=3000
